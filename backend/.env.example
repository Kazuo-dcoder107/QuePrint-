# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://queprint:queprint@localhost:5432/queprint

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-string
TOKEN_HOURS=12
CORS_ORIGINS=http://localhost:8000
# First admin account (created on first start only)
ADMIN_EMAIL=admin@queprint.app
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Shop Admin

# --- Uploads ---
MAX_UPLOAD_MB=25
MAX_PAGES=500
CLAMSCAN=false

# --- Printing ---
# simulate = no real printing (demo/testing); cups = send to a CUPS/IPP wireless printer
PRINTER_MODE=simulate
PRINTER_NAME=
MAX_ACTIVE_PRINTING=3
DISPATCH_INTERVAL=5

# --- Reservations ---
MIN_PICKUP_MINUTES=30
SHOP_NAME=QuePrint
